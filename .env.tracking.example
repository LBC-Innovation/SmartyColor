# Marketing tracking: what to add in Vercel → Project → Settings → Environment Variables
# (environment: Production). Google only for now; TikTok, Meta and Pinterest stay unset until you
# advertise there (each one loads only when its id is set).
#
# Order of operations:
#   1. Merge feat/acquisition-tracking and deploy (migration 0036 is already applied).
#   2. Add the variables below. Redeploy afterwards: NEXT_PUBLIC_* values are baked in at build time.
#   3. Fill the "<from …>" ones as each Google step is finished, then redeploy again.
# Lines marked SECRET are server-only: never paste them anywhere public.

# --- Google Analytics 4 (ready now) ----------------------------------------------------------------

# GA4 property "Colorful Memories (colorfulmemories.net)", web stream "Colorful Memories web".
NEXT_PUBLIC_GA4_ID=G-487B9X0EPT

# SECRET. Server copy of each purchase, so sales still count when an ad blocker stops the browser tag.
# GA4 → Admin → Data streams → Colorful Memories web → Measurement Protocol API secrets
# → accept the terms → Create (nickname "server purchases") → copy the "Secret value".
GA4_API_SECRET=<from GA4 Measurement Protocol API secrets>

# --- Google Ads (account 473-648-5558; after billing setup is finished) ---------------------------

# Google Ads → Goals → Conversions → Summary → "+ New conversion action" → Website → enter
# colorfulmemories.net → "Add a conversion action manually":
#   Purchase: category Purchase, value "Use different values for each conversion", count "Every".
#   Sign-up:  category Sign-up, value "Don't use a value", count "One".
# Then each action → "Tag setup" → "Install the tag yourself": the event snippet shows
# send_to: 'AW-123456789/AbCdEfGhIjK'. The part before "/" is the id; after it, the label.
NEXT_PUBLIC_GOOGLE_ADS_ID=<AW-… from the event snippet>
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=<label after the "/" for Purchase>
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=<label after the "/" for Sign-up>
# Also in Google Ads: Admin → Account settings → Auto-tagging ON, and Tracking → Final URL suffix:
#   utm_source=google&utm_medium=cpc&utm_campaign={campaignid}&utm_content={creative}&utm_term={keyword}
# And link GA4: GA4 → Admin → Product links → Google Ads links → Link → account 473-648-5558.

# --- Google Search Console --------------------------------------------------------------------------

# search.google.com/search-console → Add property → URL prefix https://colorfulmemories.net →
# "HTML tag" → copy only the content="…" value. After the redeploy, press Verify, then
# Sitemaps → submit https://colorfulmemories.net/sitemap.xml
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=<content value from the Search Console HTML tag>

# --- Follow-up emails (optional; turn on when ready) -----------------------------------------------

# 1 turns on the daily unfinished-book reminders, review requests and referral-credit notes
# (cron /api/cron/lifecycle-emails, 17:00 UTC). Uses the existing RESEND_API_KEY and CRON_SECRET.
LIFECYCLE_EMAILS_ENABLED=1

# Where review requests send people. Create a Google Business Profile (business.google.com),
# then "Ask for reviews" → copy the link. Leave unset and no review emails are sent.
REVIEW_URL=<https://g.page/r/…/review from Google Business Profile>

# --- Search listing (optional) ------------------------------------------------------------------------

# Comma-separated full URLs of your social profiles, shown to search engines as "same as" the brand.
NEXT_PUBLIC_SOCIAL_PROFILES=<https://www.instagram.com/…,https://www.facebook.com/…>

# --- Already set in Vercel (no change; listed because the features above rely on them) ------------
# NEXT_PUBLIC_SITE_URL=https://colorfulmemories.net
# CRON_SECRET, RESEND_API_KEY, EMAIL_FROM

# --- Not yet (add when you advertise there; see .env.example) --------------------------------------
# NEXT_PUBLIC_TIKTOK_PIXEL_ID, TIKTOK_EVENTS_ACCESS_TOKEN
# NEXT_PUBLIC_META_PIXEL_ID, META_CAPI_ACCESS_TOKEN, NEXT_PUBLIC_META_DOMAIN_VERIFICATION
# NEXT_PUBLIC_PINTEREST_TAG_ID, NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION
