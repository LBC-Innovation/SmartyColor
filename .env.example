# Supabase (server + public anon key for legacy SSR paths)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App URLs for auth email redirects (comma-separated optional).
# In production set these to the live domain (e.g. https://colorfulmemories.net); on Vercel
# they may be left unset and the deployment's own URL is used. Every origin used here must
# also be in Supabase > Authentication > URL Configuration > Redirect URLs.
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (transactional — order/invite mail via Resend)
RESEND_API_KEY=
EMAIL_FROM="ColorfulMemories <onboarding@resend.dev>"
# Lifecycle emails (welcome, unfinished book, holiday deadline, order, "How did it go?").
# Vercel cron calls /api/cron/lifecycle-emails hourly with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
# Signs unsubscribe and review-form links. Falls back to SUPABASE_SERVICE_ROLE_KEY when unset;
# changing it breaks links in emails already sent.
EMAIL_LINK_SECRET=

# AI provider keys stay server-side only
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Size of each generated coloring sheet: 1K, 2K (default) or 4K. Bigger prints sharper and costs more per sheet.
GEMINI_IMAGE_SIZE=2K

# Lulu Print API (sandbox: https://api.sandbox.lulu.com)
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Optional fallback if client key/secret are not set: Base64 only (no "Basic " prefix)
# LULU_CLIENT_KEY + LULU_CLIENT_SECRET are preferred when both are set.
LULU_BASIC_AUTH=
LULU_WEBHOOK_SECRET=
LULU_DEFAULT_POD_PACKAGE_ID=0850X1100.BW.STD.PB.060UW444.MXX
# Default US address for live print+ship estimates in the order wizard
LULU_QUOTE_CITY=Raleigh
LULU_QUOTE_STATE=NC
LULU_QUOTE_POSTCODE=27601
LULU_QUOTE_COUNTRY=US

# Stripe (promo wallet top-ups at order checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: POST /api/webhooks/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded
# Card top-ups are also confirmed when Stripe sends the user back, so they work
# without the webhook. Delayed methods (bank debit) need it. To receive it locally:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe

# Signed-in home screen seasonal card ("Make a book of this year"); see src/content/seasonalPrompt.ts.
# Optional: last day to show it (YYYY-MM-DD), or "off". Defaults to the date in that file.
# NEXT_PUBLIC_SEASONAL_PROMPT_UNTIL=2026-12-07
# Marketing site. Share images and canonical URLs resolve to this origin.
NEXT_PUBLIC_SITE_URL=https://colorfulmemories.net

# Analytics and ad pixels. A vendor loads only when its id is set; all are off for visitors who
# use "Do not sell or share my personal information" or send Global Privacy Control.
# In GA4, turn off Enhanced measurement > "Page changes based on browser history events": the
# app sends its own page views (with sign-in secrets stripped from the URL).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
# Server copies of `purchase` (Meta Conversions API, GA4 Measurement Protocol). Secret: server only.
META_CAPI_ACCESS_TOKEN=
# From Events Manager > Test events, while testing. Leave empty in production.
META_CAPI_TEST_EVENT_CODE=
# GA4 > Admin > Data streams > Measurement Protocol API secrets.
GA4_API_SECRET=
# 1 sends server events to GA4 DebugView.
ANALYTICS_DEBUG=

# Christmas order-by date (YYYY-MM-DD). Shows the holiday banner and checkout line through that
# day (US Pacific); empty turns them off. On Vercel, changing it needs a redeploy (no code change).
NEXT_PUBLIC_HOLIDAY_ORDER_BY=2026-12-07
