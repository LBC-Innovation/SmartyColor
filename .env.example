# Supabase (server + public anon key for legacy SSR paths)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App URLs for auth email redirects (comma-separated optional).
# In production set these to the live domain (e.g. https://colorfulmemories.net); on Vercel
# they may be left unset and the deployment's own URL is used. Every origin used here must
# also be in Supabase > Authentication > URL Configuration > Redirect URLs.
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (transactional — order/invite mail via Resend)
RESEND_API_KEY=
EMAIL_FROM="ColorfulMemories <onboarding@resend.dev>"

# AI provider keys stay server-side only
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Size of each generated coloring sheet: 1K, 2K (default) or 4K. Bigger prints sharper and costs more per sheet.
GEMINI_IMAGE_SIZE=2K

# Which vendor draws images: gemini (default) or openai. Text stays on Gemini either way.
# openai needs OPENAI_API_KEY; without it the app falls back to Gemini.
IMAGE_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium (default) | high | xhigh | max
OPENAI_IMAGE_QUALITY=medium
# Long edge in pixels (1024-3840) for photos (portrait versions). 2400 matches Gemini 2K: 1792x2400 on a 3:4 page.
OPENAI_IMAGE_LONG_EDGE=2400
# Long edge for coloring sheets; the line-art step resamples them to 2048, so more only adds time and cost.
OPENAI_SHEET_LONG_EDGE=2048
# Photos are shrunk to this long edge (px) before being sent to the image model (either vendor).
IMAGE_INPUT_MAX_EDGE=1536

# Lulu Print API (sandbox: https://api.sandbox.lulu.com)
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Optional fallback if client key/secret are not set: Base64 only (no "Basic " prefix)
# LULU_CLIENT_KEY + LULU_CLIENT_SECRET are preferred when both are set.
LULU_BASIC_AUTH=
# Lulu signs webhooks (Lulu-HMAC-SHA256) with the API client secret above, so this is normally
# left blank. If set, it is accepted in addition to LULU_CLIENT_SECRET.
LULU_WEBHOOK_SECRET=
LULU_DEFAULT_POD_PACKAGE_ID=0850X1100.BW.STD.PB.060UW444.MXX
# Default US address for live print+ship estimates in the order wizard
LULU_QUOTE_CITY=Raleigh
LULU_QUOTE_STATE=NC
LULU_QUOTE_POSTCODE=27601
LULU_QUOTE_COUNTRY=US

# Stripe (promo wallet top-ups at order checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint: POST /api/webhooks/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded
# Card top-ups are also confirmed when Stripe sends the user back, so they work
# without the webhook. Delayed methods (bank debit) need it. To receive it locally:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe

# Signed-in home screen seasonal card ("Make a book of this year"); see src/content/seasonalPrompt.ts.
# Optional: last day to show it (YYYY-MM-DD), or "off". Defaults to the date in that file.
# NEXT_PUBLIC_SEASONAL_PROMPT_UNTIL=2026-12-07
# Marketing site. Share images and canonical URLs resolve to this origin.
NEXT_PUBLIC_SITE_URL=https://colorfulmemories.net

# Analytics and ad pixels. A vendor loads only when its id is set; all are off for visitors who
# use "Do not sell or share my personal information" or send Global Privacy Control.
# In GA4, turn off Enhanced measurement > "Page changes based on browser history events": the
# app sends its own page views (with sign-in secrets stripped from the URL).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
# Server copies of `purchase` (Meta Conversions API, GA4 Measurement Protocol). Secret: server only.
META_CAPI_ACCESS_TOKEN=
# From Events Manager > Test events, while testing. Leave empty in production.
META_CAPI_TEST_EVENT_CODE=
# GA4 > Admin > Data streams > Measurement Protocol API secrets.
GA4_API_SECRET=
# 1 sends server events to GA4 DebugView.
ANALYTICS_DEBUG=

# Google Ads tag ("AW-123456789") and the conversion action labels (the part after "AW-…/" in
# each conversion's event snippet). Purchase and sign-up conversions are sent only when set.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
# TikTok pixel id (Events Manager > Web events) and an Events API access token (server only).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_ACCESS_TOKEN=
# From TikTok Events Manager > Test events, while testing. Leave empty in production.
TIKTOK_TEST_EVENT_CODE=

# Search engine and platform ownership checks: just the code from each console's meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_SITE_VERIFICATION=
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# Comma-separated social profile URLs, for search results (Organization structured data).
NEXT_PUBLIC_SOCIAL_PROFILES=

# Lifecycle emails (daily cron /api/cron/lifecycle-emails, needs migration 0036 and CRON_SECRET):
# unfinished-book reminders, review requests and referral-credit notes. 1 turns them on.
LIFECYCLE_EMAILS_ENABLED=
# Where review requests send people, e.g. your Google Business Profile review link. Unset = no review emails.
REVIEW_URL=
# Signs unsubscribe links. Optional: falls back to CRON_SECRET.
UNSUBSCRIBE_SECRET=

# Christmas order-by date (YYYY-MM-DD). Shows the holiday banner and checkout line through that
# day (US Pacific); empty turns them off. On Vercel, changing it needs a redeploy (no code change).
NEXT_PUBLIC_HOLIDAY_ORDER_BY=2026-12-07

# Guest limits (people without an account). Needs supabase/migrations/0027_guest_usage.sql applied;
# until then the limits are off and one warning is logged. Each guest page runs the paid image model.
# Per visitor per day. A visitor is a hashed IPv4 address or IPv6 /64, so phone carriers and shared
# wifi share one allowance; hence the generous defaults.
GUEST_DAILY_PAGES=8
GUEST_DAILY_EDITS=15
# Server-side photo conversion (HEIC) per visitor per day.
GUEST_DAILY_PREPARES=60
# Circuit breaker: guest pages per day across everyone. Over it, guests are asked to make an account.
GUEST_DAILY_PAGES_GLOBAL=2000
# Secret used to hash IP addresses before they are stored. Optional: without it a key derived from
# SUPABASE_SERVICE_ROLE_KEY is used. Changing it resets everyone's counts.
GUEST_USAGE_SALT=

# Shared secret for Vercel Cron (sent as "Authorization: Bearer <value>"). Generate a long random
# string; Vercel injects it automatically for cron invocations when set as an env var.
CRON_SECRET=

# Image provider bake-off only (npm run bakeoff) — not used by the app
FAL_KEY=
